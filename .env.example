# Have R/C JHS 2022 — environment example
# Copy to .env for a live Supabase connection. Never commit a real .env.
# Without these values the app runs in clearly-separated offline demo mode
# (accounts then exist only in that browser — nothing reaches Supabase).
#
# Find both values in Supabase → Project Settings → API:
#   Project URL            -> VITE_SUPABASE_URL
#   Project API keys (anon public) -> VITE_SUPABASE_ANON_KEY
# After adding/changing them you MUST restart `npm run dev` (or redeploy):
# Vite only reads env variables at startup. The Welcome screen confirms the
# connection: it shows "Connected to Supabase" instead of "Demo mode".

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# NEVER put the service-role key in the frontend, .env for Vite, or any
# VITE_* variable. Service-role keys bypass RLS — use them only in the
# Supabase SQL Editor / secure server jobs (see docs/INITIAL_ADMIN.md).

# Optional: closed-app push notifications (admins' phones ring when a
# payment is submitted, even with the app closed). Generate a key pair with
#   npx web-push generate-vapid-keys
# Put the PUBLIC key here, set BOTH keys as secrets on the Edge Function
# (see docs/PWA.md), deploy supabase/functions/notify-payment, and rebuild.
# Never put the PRIVATE key in any VITE_* variable.
VITE_VAPID_PUBLIC_KEY=
